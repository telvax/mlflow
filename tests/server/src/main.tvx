# Logs an experiment, a run and a model version to the MLflow server of MLFLOW_TRACKING_URI, and prints what it did, so
# check.py can compare it with what the server holds.
from mlflow.client import from_env
from mlflow.tracking import get_or_create, start_run, end_run, get_run, set_tag, log_param, log_metric, log_batch, log_artifact, Param, Metric, Tag, now_ms
from mlflow.registry import create_registered_model, create_model_version, set_registered_model_alias

fn main() -> Result[Text, Text]:
    let c = from_env()?
    let exp = get_or_create(c, "telvax check")?
    let again = get_or_create(c, "telvax check")?
    let run = start_run(c, exp, "sales forest")?
    log_param(c, run.run_id, "n_estimators", "100")?
    set_tag(c, run.run_id, "data", "sales.csv")?
    for step in range(3):
        log_metric(c, run.run_id, "loss", 1.0 / std.math.to_float(step + 1), step)?
    log_batch(c, run.run_id, [Param(key: "seed", value: "42"), Param(key: "max_depth", value: "none")], [Metric(key: "r2", value: 0.81, timestamp: now_ms(), step: 0)], [Tag(key: "lang", value: "telvax")])?
    log_artifact(c, run, "model/model.safetensors", std.bytes.from_text("weights of the model"))?
    let duplicate = log_param(c, run.run_id, "n_estimators", "200")
    end_run(c, run.run_id, "FINISHED")?
    let ended = get_run(c, run.run_id)?
    create_registered_model(c, "sales")?
    create_registered_model(c, "sales")?
    let version = create_model_version(c, "sales", "runs:/" + run.run_id + "/model", run.run_id)?
    set_registered_model_alias(c, "sales", "champion", version)?
    let missing = log_param(c, "no-such-run", "a", "b")
    Ok(f"experiment={exp} same={exp == again} run={run.run_id} status={ended.status} version={version} duplicate={duplicate.is_err()} missing={missing}")
